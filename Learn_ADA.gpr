project Learn_ADA is
	for Source_Dirs use ("src");
	for Object_Dir use "obj";
	for Exec_Dir use "bin";
	for Main use ("main.adb");

	package Compiler is
		for Default_Switches ("Ada") use ("-gnat2012", "-gnatwa", "-gnatVa", "-g", "-O2");
	end Compiler;

	package Builder is
		for Default_Switches ("Ada") use ("-j0");
	end Builder;
end Learn_ADA;
